# ===============================================================
# TOKO SAUDARA — ENVIRONMENT VARIABLES (SUPABASE & VERCEL)
# ===============================================================

# 1. SUPABASE DATABASE CONNECTION (PostgreSQL)
# Didapat dari Supabase Dashboard -> Project Settings -> Database
#
# Untuk Vercel Serverless (Port 6543 / Transaction Pooler dengan pgbouncer=true):
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Untuk Migrasi Prisma Direct (Port 5432 / Direct Session):
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# 2. SUPABASE API (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# 3. APP SECURITY & RUNTIME
JWT_SECRET="toko-saudara-super-secret-key-2026-dari-pasar-ke-rumah"
NODE_ENV="production"
PORT=3000
